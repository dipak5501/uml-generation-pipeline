# Stable thesis demo defaults (offline + fine-tuned code with mock fallback)
MOCK_PROVIDERS=true
USE_FINETUNED_CODE=true
FINETUNED_BASE_MODEL=mlx-community/Qwen2.5-0.5B-Instruct-4bit
FINETUNED_ADAPTER_PATH=models/uml-plantuml-lora
FINETUNED_MAX_TOKENS=512

# PlantUML rendering — remote fallback works without Java; run `make install-java` for local JDK
PLANTUML_REMOTE=true
PLANTUML_SERVER_URL=https://www.plantuml.com/plantuml

# OpenAI-compatible API (OpenAI, Together, Groq, local vLLM, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Hugging Face (dataset download + optional Inference API)
HF_TOKEN=

# Ollama (local models) — set USE_OLLAMA=true and MOCK_PROVIDERS=false
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434

# Optional — set automatically by `make install-java`
# JAVA_HOME=tools/jdk-17.0.19+10-jre/Contents/Home

# Model overrides (optional)
SPEC_MODEL=llama3.2:1b
CODE_MODEL=deepseek-r1:32b
VLM_MODELS=qwen2.5vl:3b,llama3.2-vision:11b,aya-vision:8b
