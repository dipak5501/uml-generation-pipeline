# --- Mode ---
# Offline demo (no API keys): MOCK_PROVIDERS=true
# Live Hugging Face models: MOCK_PROVIDERS=false + USE_HF_INFERENCE=true + HF_TOKEN=...
MOCK_PROVIDERS=true
USE_HF_INFERENCE=false

# Local LoRA PlantUML (Apple Silicon). Recommended when DeepSeek-32B is unavailable.
# Set false only if you want live CODE_MODEL (DeepSeek) for PlantUML.
USE_FINETUNED_CODE=false
FINETUNED_BASE_MODEL=mlx-community/Qwen2.5-0.5B-Instruct-4bit
FINETUNED_ADAPTER_PATH=models/uml-plantuml-lora
FINETUNED_MAX_TOKENS=512

# PlantUML rendering
PLANTUML_REMOTE=true
PLANTUML_SERVER_URL=https://www.plantuml.com/plantuml

# --- Hugging Face Inference Providers (recommended for Llama + DeepSeek) ---
# 1) Create token: https://huggingface.co/settings/tokens (enable Inference Providers)
# 2) Accept Llama license: https://huggingface.co/meta-llama/Llama-3.2-1B-Instruct
# 3) Set HF_TOKEN below, then MOCK_PROVIDERS=false and USE_HF_INFERENCE=true
# 4) Optional: USE_FINETUNED_CODE=true for local LoRA PlantUML while spec/VLMs stay live
HF_TOKEN=
HF_BASE_URL=https://router.huggingface.co/v1

# Paper models (Hugging Face repo ids for chat; VLM Ollama tags auto-map to HF IDs)
SPEC_MODEL=meta-llama/Llama-3.2-1B-Instruct
CODE_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-32B
# Ollama tags below are remapped to Qwen / Llama-Vision / Aya HF IDs when USE_HF_INFERENCE=true
VLM_MODELS=qwen2.5vl:3b,llama3.2-vision:11b,aya-vision:8b

# --- Ollama alternative (local) ---
# USE_OLLAMA=true MOCK_PROVIDERS=false USE_HF_INFERENCE=false
# ollama pull llama3.2:1b && ollama pull deepseek-r1:32b
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434

# --- OpenAI-compatible (optional) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional — set by `make install-java`
# JAVA_HOME=tools/jdk-17.0.19+10-jre/Contents/Home
