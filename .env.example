# Provider mode: true = offline deterministic mock (recommended for local thesis demo)
MOCK_PROVIDERS=true

# OpenAI-compatible API (OpenAI, Together, Groq, local vLLM, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Hugging Face (dataset download + optional Inference API)
HF_TOKEN=

# Ollama (local models) — set USE_OLLAMA=true and MOCK_PROVIDERS=false
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434

GH_TOKEN=

# Model overrides (optional)
SPEC_MODEL=llama3.2:1b
CODE_MODEL=deepseek-r1:32b
VLM_MODELS=qwen2.5vl:3b,llama3.2-vision:11b,aya-vision:8b

# App
DATABASE_URL=sqlite:///./data/uml_app.db
API_BASE_URL=http://127.0.0.1:8000
MAX_REPAIR_ATTEMPTS=3
IMAGE_FORMAT=png
