# --- Mode ---
# Offline demo (no API keys): MOCK_PROVIDERS=true
# Live Hugging Face models: MOCK_PROVIDERS=false + USE_HF_INFERENCE=true + HF_TOKEN=...
MOCK_PROVIDERS=true
USE_HF_INFERENCE=false

# --- Public deploy hardening (recommended on Render / any internet-facing host) ---
# When set, generate / batch / repair / rescore / human-review / export require:
#   Authorization: Bearer <token>   OR   X-API-Key: <token>
# Leave empty for local demos. Streamlit UI reads the same env var.
API_ACCESS_TOKEN=
# Comma-separated browser origins, or * for open demos (credentials disabled when *).
CORS_ORIGINS=*

# Local LoRA PlantUML (Apple Silicon). Recommended when DeepSeek-32B is unavailable.
# Set false only if you want live CODE_MODEL (DeepSeek) for PlantUML.
USE_FINETUNED_CODE=false
FINETUNED_BASE_MODEL=mlx-community/Qwen2.5-0.5B-Instruct-4bit
FINETUNED_ADAPTER_PATH=models/uml-plantuml-lora
# 512 truncates complex diagrams; 1536+ recommended for class/package.
FINETUNED_MAX_TOKENS=1536
# Score with only the first available VLM (much faster demos; not for thesis metrics).
VLM_FAST_MODE=false
# Paper VLM #3 (Aya-Vision-8B) is NOT on Ollama.
#   local          = paper-exact via transformers on this Mac (needs HF license accept)
#   ollama_standin = local llava:7b (demo only)
#   hf             = Hugging Face router (8B often unavailable)
#   openai_compat  = vLLM on GCP/GPU (see scripts/deploy_aya_vllm_gcp.sh)
VLM_AYA_BACKEND=local
AYA_VLM_MODEL=CohereLabs/aya-vision-8b
AYA_VLM_BASE_URL=
# Setup helper after accepting https://huggingface.co/CohereLabs/aya-vision-8b :
#   bash scripts/setup_paper_aya_local.sh

# PlantUML rendering
# Remote render sends diagram text to the PlantUML HTTP server (privacy risk for confidential code).
# Prefer local Java when available (avoids flaky plantuml.com timeouts).
PLANTUML_PREFER_LOCAL=true
PLANTUML_REMOTE=true
PLANTUML_SERVER_URL=https://www.plantuml.com/plantuml

# Paper acceptance gates (Stage-3)
# Majority vote: count VLMs with score >= ACCEPTANCE_TAU; need >= 2 of 3
ACCEPTANCE_TAU=4.0
# Dataset inclusion also requires composite S >= MIN_COMPOSITE_FOR_DATASET
MIN_COMPOSITE_FOR_DATASET=3.0

# Gated Hugging Face class-scored corpus (optional):
#   1) Accept license on the HF dataset page
#   2) Set HF_TOKEN below
#   3) python scripts/download_datasets.py --include-gated --only class

# --- Hugging Face Inference Providers (recommended for Llama + DeepSeek) ---
# 1) Create token: https://huggingface.co/settings/tokens (enable Inference Providers)
# 2) Accept Llama license: https://huggingface.co/meta-llama/Llama-3.2-1B-Instruct
# 3) Set HF_TOKEN below, then MOCK_PROVIDERS=false and USE_HF_INFERENCE=true
# 4) Optional: USE_FINETUNED_CODE=true for local LoRA PlantUML while spec/VLMs stay live
HF_TOKEN=
HF_BASE_URL=https://router.huggingface.co/v1

# Paper models (Hugging Face repo ids for chat; VLM Ollama tags auto-map to HF IDs)
SPEC_MODEL=meta-llama/Llama-3.2-1B-Instruct
CODE_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-32B
# Paper VLM ensemble (MMMU weights 53.1 / 50.7 / 39.9). HF remap when USE_HF_INFERENCE=true.
VLM_MODELS=qwen2.5vl:3b,llama3.2-vision:11b,aya-vision:8b

# --- Ollama alternative (local) ---
# Paper local setup uses TWO Ollama builds (see scripts/ensure_ollama_dual.sh):
#   :11434 Ollama 0.24 → llama3.2-vision:11b (+ llava stand-in for Aya)
#   :11435 Ollama 0.32 → qwen2.5vl:3b
# USE_OLLAMA=true MOCK_PROVIDERS=false USE_HF_INFERENCE=false
# ollama pull llama3.2:1b qwen2.5vl:3b llama3.2-vision:11b llava:7b
USE_OLLAMA=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_QWEN_BASE_URL=http://127.0.0.1:11435

# --- OpenAI-compatible (optional) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional — set by `make install-java`
# JAVA_HOME=tools/jdk-17.0.19+10-jre/Contents/Home

# --- Public Cloudflare quick tunnels (set by scripts/start_public_tunnels.sh) ---
# Streamlit always uses localhost for API calls; public URLs are for browser access only.
API_BASE_URL=http://127.0.0.1:8000
PUBLIC_UI_URL=
PUBLIC_API_URL=

# --- Tunnel failure email (Gmail: use an App Password, not your login password) ---
NOTIFY_EMAIL=dipak.yadav5501@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
